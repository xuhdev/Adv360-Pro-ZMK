#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define LAYER_STOCK 5

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <250>;
          quick_tap_ms = <225>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      tm: thumb_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "THUMB_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <250>;
          quick_tap_ms = <225>;
          flavor = "tap-preferred";
          bindings = <&mo>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp GRAVE &kp N1             &kp N2        &kp N3        &kp N4      &kp N5 &kp N6                                                           &mo 4     &kp N6 &kp N7   &kp N8    &kp N9   &kp N0   &kp BSPC
        &kp TAB   &kp Q              &kp W         &kp E         &kp R       &kp T  &kp LGUI                                                         &kp RGUI  &kp Y  &kp U    &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &hm LSHIFT A       &hm LALT S    &hm LGUI D    &hm LCTRL F &kp G  &kp LCTRL       &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &kp RCTRL &kp H  &hm RCTRL J  &hm RGUI K     &hm RALT L    &hm RSHIFT SEMI &kp ENTER
        &kp LSHFT &kp Z              &kp X         &kp C         &kp V         &kp B                          &kp HOME &kp PG_UP                               &kp N  &kp M    &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo 3     &kp LALT         &kp GRAVE       &kp MINUS     &hm LCTRL EQUAL            &tm 1 SPACE &mo 1 &kp END  &kp PG_DN &mo 2 &tm 2 BSPC                     &hm RCTRL LBKT &kp RBKT  &kp SQT  &kp RALT  &mo 3
      >;
    };
    secondary_left {
      display-name = "Secondary Left";
      bindings = <
        &kp F11       &kp F1        &kp F2        &kp F3    &kp F4      &kp F5 &kp F6                                                           &kp F12   &kp F6          &kp F7     &kp F8 &kp F9 &kp F10 &kp DEL
        &trans        &kp Q         &kp W         &kp END   &kp R       &kp T  &trans                                                           &trans    &msc SCRL_LEFT   &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT     &kp PSCRN  &kp BSLH
        &kp CAPSLOCK  &kp RSHFT     &kp RALT      &kp RGUI  &kp RCTRL   &trans &trans             &trans &trans &trans &trans                   &trans    &kp LEFT         &kp DOWN        &kp UP          &kp RIGHT           &trans     &trans
        &kp LSHFT     &kp RC(PG_UP) &kp RC(PG_DN) &kp C     &mkp MCLK   &kp PG_UP                        &trans &trans                                    &kp N            &kp KP_N1       &mkp MB4        &mkp MB5            &trans     &trans
        &trans        &trans    &trans    &trans    &trans                         &trans &trans &trans &trans &trans &kp DEL                                      &trans          &trans          &trans              &trans     &trans
      >;
    };
    secondary_right {
      display-name = "Secondary Right";
      bindings = <
        &kp F11       &kp F1        &kp F2        &kp F3    &kp F4      &kp F5 &kp F6                                                           &kp F12   &kp F6          &kp F7     &kp F8 &kp F9 &kp F10 &kp DEL
        &trans        &kp Q         &kp W         &kp END   &kp R       &kp T  &trans                                                           &trans    &msc SCRL_LEFT   &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT     &kp PSCRN  &kp BSLH
        &kp CAPSLOCK  &kp HOME      &mkp RCLK     &mkp LCLK &kp PG_DN   &trans &trans             &trans &trans &trans &trans                   &trans    &kp RCTRL        &kp RGUI        &kp RALT        &kp RSHFT           &trans     &trans
        &kp LSHFT     &kp RC(PG_UP) &kp RC(PG_DN) &kp C     &mkp MCLK   &kp PG_UP                        &trans &trans                                    &kp N            &kp KP_N1       &mkp MB4        &mkp MB5            &trans     &trans
        &trans        &trans    &trans    &trans    &trans                         &trans &trans &trans &trans &trans &kp DEL                                      &trans          &trans          &trans              &trans     &trans
      >;
    };
    fn {
      display-name = "Media/Fn";
      bindings = <
        &trans &trans &trans &trans &trans &trans &trans                                          &mo 4  &trans       &trans     &trans         &trans             &trans           &trans
        &trans &trans &trans &trans &trans &trans &trans                                          &trans &trans       &trans     &kp C_VOL_UP   &trans             &kp C_PLAY_PAUSE &trans
        &trans &trans &trans &trans &trans &trans &trans       &trans &trans &trans &trans        &trans &kp C_REWIND &kp C_NEXT &kp C_PREV     &kp C_FAST_FORWARD &trans           &trans
        &trans &trans &trans &trans &trans &trans                     &trans &trans                      &trans       &kp C_MUTE &kp C_VOL_DN   &trans             &trans           &trans
        &trans &trans &trans &trans &trans              &trans &trans &trans &trans &trans &trans                     &trans     &trans         &trans             &trans           &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &tog LAYER_STOCK                                                          &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    original {
      display-name = "Stock";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog LAYER_STOCK                                                 &mo 4 &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE              &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 3
      >;
    };
    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
